---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const pubs = (await getCollection('publications')).sort((a, b) => {
  if (b.data.year !== a.data.year) return b.data.year - a.data.year;
  return b.data.order - a.data.order;
});

const news = (await getCollection('news')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const fmtYear = (iso: string) => new Date(iso).getFullYear();

// Papers I led (first or corresponding author) get their own group at the top;
// the rest fall into year groups. pubs is already sorted year-descending.
const isLead = (p: (typeof pubs)[number]) =>
  p.data.authors[0]?.me === true || p.data.authors.some((au) => au.me && au.corresponding);

const leadPubs = pubs.filter(isLead);
const otherPubs = pubs.filter((p) => !isLead(p));

const pubGroups: { label: string; items: typeof pubs }[] = [];
if (leadPubs.length) pubGroups.push({ label: 'First / corresponding author', items: leadPubs });
for (const p of otherPubs) {
  const g = pubGroups.at(-1);
  if (g && g.label === String(p.data.year)) g.items.push(p);
  else pubGroups.push({ label: String(p.data.year), items: [p] });
}

// Shown as a faint tag next to the venue; published work needs no tag.
const statusLabel: Record<string, string> = {
  preprint: 'Preprint',
  'under-review': 'Under review',
  accepted: 'Accepted',
};

const experience = [
  {
    period: '2022 — 2023', role: 'RL Algorithms Engineer', org: 'InspirAI, Hangzhou', honor: 'Top Performance Team',
    detail: 'Built a card-game AI SDK shipped across four production titles; the Landlord agent reached super-human level against top-ranked professional players. A similar (independently developed) approach also powered a Guandan agent, improving its win rate by 6%.',
    video: 'https://www.bilibili.com/video/BV19o4y1s7Kf/',
    code: null,
    product: 'https://www.taptap.cn/app/240710',
    demos: [
      { src: '/images/doudizhu-screenshot.jpg', w: 760, h: 428, cap: 'Dou Dizhu (Landlord) — the flagship title shipping the card-game AI' },
      { src: '/images/guandan-ai-demo.gif', w: 480, h: 267, cap: 'Guandan AI — four agents in a live match (a similar RL approach)' },
    ],
  },
  {
    period: '2021', role: 'RL Research Intern', org: 'Baidu, Beijing', honor: 'Super Special Offer',
    detail: 'Single-handedly developed EDA-MAPPO — the full algorithm and its performance gains — and shipped it into a client production environment.',
    video: 'https://www.bilibili.com/video/BV1LV411p7KD/',
    code: 'https://github.com/tinyzqh/light_mappo',
    product: null,
    demos: [
      { src: '/images/baidu-mappo-demo.gif', w: 460, h: 208, cap: 'Deployed system — UAV swarm engaging a naval target (EDA-MAPPO)' },
      { src: '/images/light-mappo-demo.gif', w: 400, h: 400, cap: 'light_mappo — open-source prototype (multi-agent PPO)' },
    ],
  },
];

const service: { name: string; cert?: string }[] = [
  { name: 'ACM International Conference on Multimedia (ACM MM 2026)' },
  { name: 'IEEE Transactions on Multimedia' },
  { name: 'IEEE Transactions on Network Science and Engineering' },
  { name: 'IEEE Internet of Things Journal' },
  { name: 'IEEE Open Journal of the Computer Society', cert: '/papers/ojcs-2025-reviewer.pdf' },
];

const links = [
  { href: '#publications', label: 'Publications' },
  { href: '/resources', label: 'Resources' },
  { href: 'mailto:tinyzqh@gmail.com', label: 'Email' },
  { href: 'https://scholar.google.com.hk/citations?hl=zh-CN&user=v6o0Dz8AAAAJ', label: 'Google Scholar' },
  { href: 'https://github.com/tinyzqh', label: 'GitHub' },
  { href: 'https://www.zhihu.com/people/zhiqianghe', label: 'Zhihu' },
  { href: '/cv', label: 'CV' },
];

// A link sitting inside running text — coloured and weighted so it reads as one
const inlineLink =
  'font-medium text-accent underline decoration-accent/30 underline-offset-[3px] transition-colors duration-200 hover:text-accent-hover hover:decoration-accent/70';

// Quiet by default, underline emerges on hover — keeps dense link rows calm
const link =
  'underline decoration-transparent underline-offset-[3px] transition-colors duration-200 hover:decoration-current';
const ext = (href: string) =>
  href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {};

// Section label sits in the left margin; content owns the right column
const row = 'grid gap-x-10 gap-y-3 sm:grid-cols-[6.5rem_minmax(0,1fr)]';
const label =
  'text-[11px] font-medium uppercase tracking-[0.16em] text-muted/70 sm:pt-1';
---

<BaseLayout
  title="Zhiqiang He"
  description="Zhiqiang He (何志强) — Ph.D. researcher at the University of Electro-Communications, Tokyo, working on reinforcement learning. Publications, experience, awards, and academic service."
>
  <div class="mx-auto max-w-[68rem] px-6 py-20 sm:py-28">
    <!-- Identity -->
    <header class={row}>
      <div class="sm:pt-1">
        <h2 class={`${label} mb-3`}>About</h2>
        <img
          src="/images/tinyzqh.jpg"
          alt="Zhiqiang He"
          width="104"
          height="104"
          class="h-[4.5rem] w-[4.5rem] rounded-full object-cover"
          loading="eager"
        />
      </div>

      <div>
        <h1 class="text-[1.75rem] font-semibold leading-tight tracking-[-0.02em] sm:text-[2rem]">
          Zhiqiang He <span lang="zh" class="font-normal text-muted">何志强</span>
        </h1>

        <div class="mt-4 max-w-[72ch] space-y-3 text-justify hyphens-auto text-[1.0625rem] leading-[1.7] text-fg/90">
          <p>
            Ph.D. researcher in Information Science at the University of Electro-Communications,
            Tokyo, advised by
            <a href="https://scholar.google.com/citations?user=95oIprAAAAAJ&hl=en" class={inlineLink} target="_blank" rel="noopener">Prof. Zhi Liu</a>.
            What I care about is how AI can interact directly with the real world — not an
            agent that scores well inside a simulator, but one that still works when it meets
            real users, real networks, and real hardware.
          </p>

          <p>
            Before that I received my M.S. in Control Science and Engineering from Northeastern
            University, Shenyang, advised by
            <a href="http://faculty.neu.edu.cn/wangjiao/zh_CN/zhym/75393/list/index.htm" class={inlineLink} target="_blank" rel="noopener">Prof. Jiao Wang</a>.
          </p>

          <p>
            That is also why I spent time in industry — an RL algorithms engineer at InspirAI
            and a research intern at Baidu — where the agents I built had to leave the lab and
            face real players and real deployments.
          </p>
        </div>

        <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-[0.9375rem] text-muted">
          {links.map(({ href, label: text }) => (
            <li><a href={href} class={`${link} hover:text-fg`} {...ext(href)}>{text}</a></li>
          ))}
        </ul>
      </div>
    </header>

    <!-- Experience -->
    <section id="experience" class={`${row} mt-24 scroll-mt-16`}>
      <h2 class={label}>Experience</h2>

      <ol class="space-y-7">
        {experience.map((pos) => (
          <li>
            <p class="text-[0.875rem] tabular-nums text-muted/70">{pos.period}</p>
            <p class="mt-1 flex flex-wrap items-baseline gap-x-4 gap-y-1 text-[1.0625rem] font-medium leading-snug text-fg">
              <span>{pos.role}<span class="font-normal text-muted"> · {pos.org}</span>{pos.honor && <span class="ml-2 whitespace-nowrap rounded-full border border-accent/30 px-2 py-px align-[0.1em] text-[0.75rem] font-medium tracking-[0.01em] text-accent/90">{pos.honor}</span>}</span>
              {(pos.video || pos.code || pos.product) && (
                <span class="flex flex-wrap gap-x-4 gap-y-1 text-[0.875rem]">
                  {pos.video && <a href={pos.video} class={inlineLink} target="_blank" rel="noopener">Video</a>}
                  {pos.product && <a href={pos.product} class={inlineLink} target="_blank" rel="noopener">Product</a>}
                  {pos.code && <a href={pos.code} class={inlineLink} target="_blank" rel="noopener">Prototype code</a>}
                </span>
              )}
            </p>
            {pos.detail && (
              <p class="mt-1.5 max-w-[82ch] text-justify hyphens-auto text-[0.9375rem] leading-relaxed text-muted/85">
                {pos.detail}
              </p>
            )}
            {pos.demos && (
              <div class="mt-3 flex flex-wrap items-start gap-4">
                {pos.demos.map((d) => (
                  <figure class="max-w-full">
                    <img
                      src={d.src}
                      alt={d.cap}
                      width={d.w}
                      height={d.h}
                      loading="lazy"
                      class="h-[7.5rem] w-auto rounded-lg ring-1 ring-border/60"
                    />
                    <figcaption class="mt-1.5 max-w-[17rem] text-[0.8125rem] leading-relaxed text-muted/60">
                      {d.cap}
                    </figcaption>
                  </figure>
                ))}
              </div>
            )}
          </li>
        ))}
      </ol>
    </section>

    <!-- Awards -->
    <section id="awards" class={`${row} mt-24 scroll-mt-16`}>
      <h2 class={label}>Awards</h2>

      <ol class="space-y-4">
        {news.map((n) => (
          <li class="flex gap-5">
            <span class="shrink-0 text-[0.9375rem] tabular-nums text-muted/70">
              {n.data.period ?? fmtYear(n.data.date)}
            </span>
            <span class="text-[0.9375rem] leading-relaxed text-fg/90">{n.data.title}</span>
          </li>
        ))}
      </ol>
    </section>

    <!-- Academic service -->
    <section id="service" class={`${row} mt-24 scroll-mt-16`}>
      <h2 class={label}>Service</h2>

      <div class="space-y-6">
        <div>
          <p class="text-[0.9375rem] text-muted/85">Peer reviewer for</p>
          <ul class="mt-2 space-y-1.5 text-[0.9375rem] leading-relaxed text-fg/90">
            {service.map((s) => (
              <li>
                {s.name}
                {s.cert && <a href={s.cert} class={`${link} ml-1.5 text-[0.8125rem] text-muted/70 hover:text-fg`} target="_blank" rel="noopener">Certificate</a>}
              </li>
            ))}
          </ul>
        </div>

        <div>
          <p class="text-[0.9375rem] text-muted/85">Conference volunteer</p>
          <ul class="mt-2 space-y-1.5 text-[0.9375rem] leading-relaxed text-fg/90">
            <li>
              Student Volunteer, IEEE INFOCOM 2026, Tokyo
              <a href="/papers/infocom2026-volunteer.pdf" class={`${link} ml-1.5 text-muted/70 hover:text-fg`} target="_blank" rel="noopener">Certificate</a>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Publications -->
    <section id="publications" class={`${row} mt-24 scroll-mt-16`}>
      <div>
        <h2 class={label}>Selected Publications</h2>
        <div class="mt-2.5 hidden flex-col gap-1 text-[0.6875rem] text-muted/50 sm:flex">
          <span class="flex items-center gap-1.5">
            <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-accent/70"></span> first author
          </span>
          <span class="flex items-center gap-1.5">
            <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-accent2/80"></span> corresponding author
          </span>
        </div>
      </div>

      <div class="space-y-10">
        <p class="text-[0.9375rem] leading-relaxed text-muted">
          For a complete list of publications, please visit my
          <a
            href="https://scholar.google.com.hk/citations?hl=zh-CN&user=v6o0Dz8AAAAJ"
            class={inlineLink}
            target="_blank"
            rel="noopener"
          >Google Scholar</a> page.
        </p>

        {pubGroups.map((grp) => (
          <div>
            <div class="mb-6 flex items-center gap-4">
              <span class="text-[0.8125rem] font-medium tabular-nums text-muted/55">{grp.label}</span>
              <span class="h-px flex-1 bg-border/40"></span>
            </div>

            <ol class="space-y-9">
              {grp.items.map((p) => {
                // Mark papers I led — blue dot for first author, teal dot for corresponding.
                const isFirst = p.data.authors[0]?.me === true;
                const isCorr = p.data.authors.some((au) => au.me && au.corresponding);
                const dotBase =
                  'relative before:absolute before:-left-[1.125rem] before:top-[0.55em] before:h-1.5 before:w-1.5 before:rounded-full';
                const marker = isFirst
                  ? `${dotBase} before:bg-accent/70`
                  : isCorr
                  ? `${dotBase} before:bg-accent2/80`
                  : '';
                return (
                <li class={marker}>
                  <div class="sm:grid sm:grid-cols-[11.5rem_minmax(0,1fr)] sm:gap-x-6">
                    {p.data.image ? (
                      <a
                        href={p.data.paperUrl ?? p.data.pdf}
                        class="mb-3 block aspect-[4/3] overflow-hidden rounded-md border border-border/50 bg-white sm:mb-0 dark:opacity-90 dark:hover:opacity-100"
                        target="_blank"
                        rel="noopener"
                        tabindex="-1"
                        aria-hidden="true"
                      >
                        <img
                          src={p.data.image}
                          alt=""
                          loading="lazy"
                          decoding="async"
                          class="h-full w-full object-contain transition-opacity duration-200 hover:opacity-85"
                        />
                      </a>
                    ) : (
                      <div class="hidden sm:block"></div>
                    )}

                    <div>
                      <h3 class="text-[1.0625rem] font-medium leading-snug tracking-[-0.01em] text-fg">
                        {p.data.title}
                      </h3>

                      <p class="mt-1.5 text-[0.9375rem] leading-relaxed text-muted">
                        {p.data.authors.map((au, i) => (
                          <>
                            <span class={au.me ? 'text-fg underline decoration-fg/45 underline-offset-[3px]' : ''}>{au.name}</span>{au.corresponding && <sup>*</sup>}{i < p.data.authors.length - 1 ? ', ' : ''}
                          </>
                        ))}
                      </p>

                      <p class="mt-1 text-[0.9375rem] text-muted/85">
                        <span class="text-fg/70">{p.data.venue}</span><span class="tabular-nums">, {p.data.year}</span>{p.data.impactFactor && <span class="tabular-nums"> · IF {p.data.impactFactor}</span>}{p.data.quartile && <span> · JCR {p.data.quartile}</span>}{p.data.ccf && <span> · CCF-{p.data.ccf}</span>}{statusLabel[p.data.status] && <span class="ml-2 rounded-full border border-border/60 px-2 py-px text-[0.6875rem] font-medium uppercase tracking-[0.06em] text-muted/70 align-[0.08em]">{statusLabel[p.data.status]}</span>}
                      </p>

                      <p class="mt-2 flex flex-wrap gap-x-5 gap-y-1 text-[0.875rem] text-muted/70">
                        {p.data.paperUrl && !(p.data.arxiv && p.data.paperUrl.includes(`arxiv.org/abs/${p.data.arxiv}`)) && <a href={p.data.paperUrl} class={`${link} hover:text-fg`} target="_blank" rel="noopener">Paper</a>}
                        {p.data.arxiv && <a href={`https://arxiv.org/abs/${p.data.arxiv}`} class={`${link} hover:text-fg`} target="_blank" rel="noopener">arXiv</a>}
                        {p.data.project && <a href={p.data.project} class={`${link} hover:text-fg`} target="_blank" rel="noopener">Project</a>}
                        {p.data.pdf && <a href={p.data.pdf} class={`${link} hover:text-fg`} target="_blank" rel="noopener">PDF</a>}
                        {p.data.code && <a href={p.data.code} class={`${link} hover:text-fg`} target="_blank" rel="noopener">Code</a>}
                      </p>
                    </div>
                  </div>
                </li>
                );
              })}
            </ol>
          </div>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
