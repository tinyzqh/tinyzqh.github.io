---
import ThemeToggle from '~/components/ThemeToggle.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHome = path === '/';
---

<header>
  <div class="mx-auto flex h-14 max-w-[52rem] items-center justify-between px-6">
    {isHome ? (
      <span></span>
    ) : (
      <a
        href="/"
        class="text-[0.9375rem] text-muted underline decoration-transparent underline-offset-[3px] transition-colors hover:text-fg hover:decoration-current"
      >
        ← Zhiqiang He
      </a>
    )}
    <ThemeToggle />
  </div>
</header>
